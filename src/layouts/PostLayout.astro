---
import BaseLayout from './BaseLayout.astro';
import ContentScales from '../components/ContentScales.astro';

interface WorkEntry {
  title: string;
  image?: string;
  imageAlt?: string;
  description: string;
  platform?: string;
  affiliateUrl?: string;
}

interface ScaleItem {
  label: string;
  oppositeLabel: string;
  value: number;
}

interface RelatedPost {
  id: string;
  title: string;
  description: string;
}

interface NextRead {
  id: string;
  title: string;
  reason: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  genre: string;
  tropes: string[];
  tone?: string;
  tags?: string[];
  coverImage?: string;
  coverImageAlt?: string;
  works?: WorkEntry[];
  scales?: ScaleItem[];
  relatedPosts?: RelatedPost[];
  points?: string[];
  nextReads?: NextRead[];
}

const {
  title, description, pubDate, updatedDate, genre, tropes, tone, tags,
  coverImage, coverImageAlt, works, scales, relatedPosts, points, nextReads,
} = Astro.props;

// ==== 探偵の窓口(A8)の導線 ====
// 「浮気・不倫」の作品分類(tropes)を持つ記事だけに表示する。
// リンクのコードはA8.netの広告リンク作成画面(素材ID001)からコピーしたもの(2026-11-03)。
const TANTEI_TROPE = '浮気・不倫';
const A8_TANTEI_LINK = `<a href="https://px.a8.net/svt/ejp?a8mat=4BGCEZ+BFZZEA+5YAQ+5YJRM" rel="nofollow">相談無料・業界最安水準！厳選探偵をワンストップで紹介【探偵の窓口】</a>
<img border="0" width="1" height="1" src="https://www15.a8.net/0.gif?a8mat=4BGCEZ+BFZZEA+5YAQ+5YJRM" alt="">`;
const showTantei = tropes.includes(TANTEI_TROPE);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={title} description={description} pubDate={pubDate} updatedDate={updatedDate} type="article">
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && <span> (更新: {formatDate(updatedDate)})</span>}
      </p>
      <p class="tags">
        <a class="tag genre-tag" href={`/genre/${encodeURIComponent(genre)}/`}>{genre}</a>
        {tropes.map((t) => <span class="tag">{t}</span>)}
        {tone && <span class="tag tone-tag">{tone}</span>}
      </p>
      {tags && tags.length > 0 && (
        <p class="hashtags">
          {tags.map((t) => <span class="hashtag">#{t}</span>)}
        </p>
      )}
      {coverImage && (
        <img src={coverImage} alt={coverImageAlt || title} class="cover-image" />
      )}
    </header>

    {points && points.length > 0 && (
      <aside class="post-points">
        <h2>この記事のポイント</h2>
        <ul>{points.map((p) => <li>{p}</li>)}</ul>
      </aside>
    )}

    <div class="post-body">
      <slot />
    </div>

    {showTantei && (
      <aside class="tantei-cta">
        <span class="pr-label">PR</span>
        <h2>浮気の疑いを探偵に相談するなら|浮気調査の探偵・興信所を比較する方法</h2>
        <p>作品の主人公のように、パートナーや配偶者の浮気を疑いながら一人で抱え込んでしまう方。証拠も相談相手もないまま考え続けるより、浮気調査を扱う探偵に状況を話して、取れる選択肢を整理するという方法もあります。「離婚」「修復」どちらの選択をするにしても証拠を押さえておくことはかなり重要。</p>
        <p>ただ、探偵事務所や興信所の料金や調査内容を自分で比較して選ぶのは大変です。</p>
        <p>浮気調査の探偵選びに迷う場合は、アンケート形式で条件を選択していくと自分に合った探偵社を無料で紹介してもらえるサービスもあります。</p>
        <p>まずは「浮気危険度診断」をしてみてもいいかも。</p>
        <div class="tantei-link" set:html={A8_TANTEI_LINK} />
      </aside>
    )}

    {scales && scales.length > 0 && <ContentScales scales={scales} />}

    {works && works.length > 0 && (
      <div class="works-grid">
        {works.map((w) => (
          <div class="work-card">
            {w.image && <img src={w.image} alt={w.imageAlt || w.title} />}
            <h3>{w.title}</h3>
            <p>{w.description}</p>
            {w.platform && <p class="work-platform">{w.platform}</p>}
            {w.affiliateUrl && (
              <a href={w.affiliateUrl} class="work-link" rel="sponsored noopener" target="_blank">
                読む
              </a>
            )}
          </div>
        ))}
      </div>
    )}
  </article>

  {nextReads && nextReads.length > 0 && (
    <section class="next-reads">
      <h2>次に読むなら</h2>
      <ul>
        {nextReads.map((n) => (
          <li>
            <a href={`/blog/${n.id}/`}>{n.title}</a>
            <p>{n.reason}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedPosts && relatedPosts.length > 0 && (
    <section class="related-posts">
      <h2>関連記事</h2>
      <ul>
        {relatedPosts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`}>{p.title}</a>
            <p>{p.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .post-points {
    background: #f7f9fc;
    border-left: 4px solid #6b7fd7;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    border-radius: 4px;
  }
  .post-points h2 { font-size: 1.05rem; margin: 0 0 0.5rem; }
  .post-points ul { margin: 0; padding-left: 1.2rem; }
  .post-points li { margin: 0.3rem 0; line-height: 1.6; }
  .tantei-cta {
    margin: 2.5rem 0 1rem;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid #e6e2dc;
    border-radius: 8px;
    background: #fbfaf8;
  }
  .tantei-cta h2 { font-size: 1.05rem; margin: 0 0 0.75rem; }
  .tantei-cta p { line-height: 1.8; margin: 0.5rem 0; }
  .tantei-link { text-align: center; margin: 1rem 0 0.25rem; }
  .tantei-link :global(a) {
    display: inline-block;
    background: #ff6f61;
    color: #fff !important;
    font-weight: 700;
    padding: 0.75rem 1.8rem;
    border-radius: 999px;
    text-decoration: none !important;
  }
  .tantei-cta { position: relative; }
  .pr-label {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    font-size: 0.7rem;
    color: #888;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 0 0.3rem;
    line-height: 1.4;
  }
  .next-reads { margin-top: 2.5rem; }
  .next-reads li { margin-bottom: 1rem; }
  .next-reads p { color: #555; font-size: 0.9rem; margin: 0.2rem 0 0; }
  .post-header { margin-bottom: 2rem; }
  .meta { color: #888; font-size: 0.9rem; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .tag {
    display: inline-block;
    background: #f0f2f5;
    color: #444;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    font-size: 0.8rem;
    text-decoration: none;
  }
  .genre-tag { background: #dbe9ff; color: #1a4d8f; }
  .tone-tag { background: #fdeedc; color: #8a5a1f; }
  .hashtags { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .hashtag { color: #6b7fd7; font-size: 0.85rem; font-weight: 500; }
  .cover-image { border-radius: 10px; margin-top: 1.25rem; width: 100%; }
  .post-body :global(h2) { margin-top: 2.5rem; }
  .post-body :global(img) { border-radius: 8px; margin: 1rem 0; }

  /* ==== 記事内の表(Markdownの表) ==== */
  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .post-body :global(th),
  .post-body :global(td) {
    border: 1px solid #ddd;
    padding: 0.6rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }
  .post-body :global(th) {
    background: #f7f9fc;
    font-weight: 700;
  }
  .post-body :global(tbody tr:nth-child(even)) {
    background: #fafafa;
  }
  /* スマホでは表を横スクロールにして、ページ全体がはみ出さないようにする */
  @media (max-width: 600px) {
    .post-body :global(table) {
      display: block;
      overflow-x: auto;
      font-size: 0.85rem;
    }
    .post-body :global(th),
    .post-body :global(td) {
      min-width: 8em;
    }
  }

  .works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .work-card {
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 1rem;
  }
  .work-card img { border-radius: 6px; width: 100%; margin-bottom: 0.5rem; }
  .work-card h3 { font-size: 1rem; margin: 0.3rem 0; }
  .work-card p { font-size: 0.85rem; color: #555; }
  .work-platform { color: #999 !important; font-size: 0.75rem !important; }
  .work-link {
    display: inline-block;
    margin-top: 0.5rem;
    background: #ff6f61;
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.85rem;
  }

  .related-posts {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #eee;
  }
  .related-posts h2 { font-size: 1.1rem; }
  .related-posts ul { list-style: none; padding: 0; }
  .related-posts li { padding: 0.9rem 0; border-bottom: 1px solid #f0f0f0; }
  .related-posts a { color: #1a4d8f; font-weight: 600; text-decoration: none; }
  .related-posts p { color: #666; font-size: 0.85rem; margin: 0.3rem 0 0; }
</style>

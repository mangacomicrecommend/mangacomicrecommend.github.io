---
interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  type?: 'website' | 'article';
}

const { title, description, pubDate, updatedDate, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'マンガ分類ノート'; // ★ サイト名に変更してください
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}

    <!-- JSON-LD structured data -->
    {type === 'article' ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description: description,
        datePublished: pubDate?.toISOString(),
        dateModified: (updatedDate ?? pubDate)?.toISOString(),
        author: { '@type': 'Person', name: siteName },
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        url: Astro.site,
      })} />
    )}

    <!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9N9JJNPX5T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-9N9JJNPX5T');
    </script>

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/" class="logo">{siteName}</a>
        <a href="/blog/">記事一覧</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} {siteName}</p>
      <p class="footer-links">
        <a href="/privacy-policy/">プライバシーポリシー</a>
        ・
        <a href="/contact/">お問い合わせ</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
    line-height: 1.8;
    color: #222;
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .site-header nav {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid #eee;
  }
  .site-header .logo {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    color: #222;
  }
  .site-header a {
    color: #444;
    text-decoration: none;
  }
  main {
    padding: 2rem 0;
    min-height: 60vh;
  }
  .site-footer {
    border-top: 1px solid #eee;
    padding: 1.5rem 0;
    color: #888;
    font-size: 0.85rem;
  }
  .footer-links a {
    color: #888;
  }
  img { max-width: 100%; height: auto; }
  h1, h2, h3 { line-height: 1.4; }

  /* ==== アフィリエイトCTAボタン ====
     記事のMarkdown本文内に、以下のHTMLをそのまま貼り付けて使えます:

     <div class="affiliate-cta">
       <a href="【アフィリエイトリンク】" class="cta-button" rel="sponsored noopener" target="_blank">
         コミックシーモアで読む
       </a>
       <p class="cta-note">初回登録で〇〇特典</p>
     </div>

     記事1本につき2〜4回(冒頭・中盤・終盤)差し込むのがおすすめです。
  */
  .affiliate-cta {
    text-align: center;
    margin: 1.75rem 0;
  }
  .cta-button {
    display: inline-block;
    background: #ff6f61;
    color: #fff !important;
    font-weight: 700;
    font-size: 1rem;
    padding: 0.85rem 2.2rem;
    border-radius: 999px;
    text-decoration: none !important;
    box-shadow: 0 3px 10px rgba(255, 111, 97, 0.35);
  }
  .cta-button:hover {
    background: #ff5a4a;
  }
  .cta-note {
    font-size: 0.78rem;
    color: #888;
    margin-top: 0.5rem;
  }
</style>

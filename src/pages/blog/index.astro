---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="記事一覧" description="これまでに書いた記事の一覧です。">
  <h1>記事一覧</h1>
  <ul class="post-list">
    {allPosts.map((post) => (
      <li>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        <p class="excerpt">{post.data.description}</p>
        <p class="meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
          ・<a href={`/genre/${encodeURIComponent(post.data.genre)}/`}>{post.data.genre}</a>
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .post-list { list-style: none; padding: 0; }
  .post-list li { padding: 1.25rem 0; border-bottom: 1px solid #eee; }
  .post-list a { font-size: 1.1rem; font-weight: 600; color: #1a4d8f; text-decoration: none; }
  .excerpt { color: #555; margin: 0.4rem 0; }
  .meta { color: #888; font-size: 0.85rem; }
  .meta a { color: #888; }
</style>
